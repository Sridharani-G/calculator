using System;
using System.Windows;
using System.Windows.Controls;

namespace WpfCalculator
{
    public partial class MainWindow : Window
    {
        double firstNumber = 0;
        string operation = "";
        bool newNumber = true;

        public MainWindow()
        {
            InitializeComponent();
        }

        private void Number_Click(object sender, RoutedEventArgs e)
        {
            string value = ((Button)sender).Content.ToString();

            if (newNumber)
            {
                txtDisplay.Text = value == "." ? "0." : value;
                newNumber = false;
            }
            else
            {
                if (value == "." && txtDisplay.Text.Contains("."))
                    return;

                txtDisplay.Text += value;
            }
        }

        private void Operator_Click(object sender, RoutedEventArgs e)
        {
            if (!double.TryParse(txtDisplay.Text, out firstNumber))
                return;

            operation = ((Button)sender).Content.ToString();
            newNumber = true;
        }

        private void Equals_Click(object sender, RoutedEventArgs e)
        {
            if (!double.TryParse(txtDisplay.Text, out double secondNumber))
                return;

            double result;

            switch (operation)
            {
                case "+":
                    result = firstNumber + secondNumber;
                    break;

                case "-":
                    result = firstNumber - secondNumber;
                    break;

                case "*":
                    result = firstNumber * secondNumber;
                    break;

                case "/":
                    if (secondNumber == 0)
                    {
                        txtDisplay.Text = "Cannot divide by zero";
                        newNumber = true;
                        return;
                    }

                    result = firstNumber / secondNumber;
                    break;

                default:
                    return;
            }

            txtDisplay.Text = result.ToString();
            newNumber = true;
            operation = "";
        }

        private void Clear_Click(object sender, RoutedEventArgs e)
        {
            txtDisplay.Text = "";
            firstNumber = 0;
            operation = "";
            newNumber = true;
        }
    }
}
